{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeonGit",
  "version": "0.1.0",
  "identifier": "com.leongit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LeonGit",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Light",
        "decorations": false,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#f7f5f0"
      }
    ],
    "appDirectoriesOverride": {
      "config": "./Data/config",
      "data": "./Data/data",
      "localData": "./Data/local-data",
      "cache": "./Data/cache",
      "log": "./Data/logs"
    },
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Offline Git desktop client",
    "longDescription": "LeonGit is a fast, offline-first desktop client for browsing local Git repositories.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/nsis-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
